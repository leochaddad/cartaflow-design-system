{
  "$description": "Raw brand values. Never use these directly in product code; use the semantic tokens. Brand names: red = Vermelhão, navy = Marinho, paper = Papel postal, ink = Cinza tinta.",
  "color": {
    "$type": "color",
    "red": {
      "50": { "$value": "#FDF3F1" },
      "100": { "$value": "#FBE6E1" },
      "200": { "$value": "#F4D4CC", "$description": "Rosa carimbo" },
      "300": { "$value": "#EBAE9F" },
      "400": { "$value": "#E07D67" },
      "500": { "$value": "#D6533B" },
      "600": { "$value": "#CC3421", "$description": "Vermelhão, the brand red" },
      "700": { "$value": "#B32C1A" },
      "800": { "$value": "#922414" },
      "900": { "$value": "#761F13" },
      "950": { "$value": "#420C06" }
    },
    "navy": {
      "50": { "$value": "#F2F4F8" },
      "100": { "$value": "#E3E7EF" },
      "200": { "$value": "#C7CEDD" },
      "300": { "$value": "#A0AAC2" },
      "400": { "$value": "#7381A0" },
      "500": { "$value": "#526182" },
      "600": { "$value": "#3D4B6B" },
      "700": { "$value": "#2C3A58" },
      "800": { "$value": "#1E2B47" },
      "900": { "$value": "#14213D", "$description": "Marinho, the brand navy" },
      "925": { "$value": "#101A2E" },
      "950": { "$value": "#0B1324" },
      "975": { "$value": "#070D1A" }
    },
    "paper": {
      "0": { "$value": "#FFFEFB", "$description": "Paper white" },
      "50": { "$value": "#FAF9F6" },
      "100": { "$value": "#F6F4EF", "$description": "Papel postal, the page background" },
      "200": { "$value": "#EFECE5" },
      "300": { "$value": "#E6E2D9" },
      "400": { "$value": "#DDD9D0" },
      "500": { "$value": "#C8C3B8" },
      "600": { "$value": "#A6A196" },
      "700": { "$value": "#7F7A70" },
      "800": { "$value": "#59554D" },
      "900": { "$value": "#36332E" }
    },
    "ink": {
      "300": { "$value": "#A9B0C0" },
      "400": { "$value": "#8A90A0" },
      "500": { "$value": "#6B7185" },
      "600": { "$value": "#5B6275", "$description": "Cinza tinta" },
      "700": { "$value": "#474D5E" }
    },
    "green": {
      "50": { "$value": "#ECF6F0" },
      "100": { "$value": "#D3EBDD" },
      "400": { "$value": "#5CC08B" },
      "600": { "$value": "#1E7A4C" },
      "700": { "$value": "#17603C" },
      "950": { "$value": "#0F2A21" }
    },
    "amber": {
      "50": { "$value": "#FDF5E7" },
      "100": { "$value": "#FAE6C2" },
      "400": { "$value": "#E9A23B" },
      "600": { "$value": "#A35B00" },
      "700": { "$value": "#844A00" },
      "950": { "$value": "#2B2110" }
    },
    "crimson": {
      "50": { "$value": "#FDECEA" },
      "100": { "$value": "#F9D3CE" },
      "400": { "$value": "#F27A6E" },
      "600": { "$value": "#B42318" },
      "700": { "$value": "#912018" },
      "950": { "$value": "#2D1418" }
    },
    "blue": {
      "50": { "$value": "#EEF3FB" },
      "100": { "$value": "#D9E4F6" },
      "400": { "$value": "#7FA6EA" },
      "600": { "$value": "#2E5AAC" },
      "700": { "$value": "#234786" },
      "950": { "$value": "#12213D" }
    },
    "white": { "$value": "#FFFFFF" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Bricolage Grotesque", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SF Mono", "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4 px grid. These are the only allowed spacing values.",
    "0": { "$value": "0px" },
    "0-5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "1-5": { "$value": "6px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" },
    "40": { "$value": "160px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs": { "$value": "4px" },
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "14px" },
    "xl": { "$value": "20px" },
    "2xl": { "$value": "28px" },
    "full": { "$value": "9999px" }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "strong": { "$value": "1.5px" },
    "focus": { "$value": "2px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Navy-tinted, never pure black. Light theme values.",
    "xs": { "$value": "0 1px 1px rgba(20, 33, 61, 0.05)" },
    "sm": { "$value": "0 1px 2px rgba(20, 33, 61, 0.06), 0 1px 3px rgba(20, 33, 61, 0.04)" },
    "md": { "$value": "0 2px 4px rgba(20, 33, 61, 0.04), 0 8px 16px -4px rgba(20, 33, 61, 0.08)" },
    "lg": { "$value": "0 4px 8px rgba(20, 33, 61, 0.04), 0 20px 40px -12px rgba(20, 33, 61, 0.16)" },
    "xl": { "$value": "0 8px 16px rgba(20, 33, 61, 0.06), 0 32px 64px -16px rgba(20, 33, 61, 0.24)" }
  },
  "shadow-dark": {
    "$type": "shadow",
    "xs": { "$value": "0 1px 1px rgba(0, 0, 0, 0.30)" },
    "sm": { "$value": "0 1px 2px rgba(0, 0, 0, 0.36), 0 1px 3px rgba(0, 0, 0, 0.24)" },
    "md": { "$value": "0 2px 4px rgba(0, 0, 0, 0.30), 0 8px 16px -4px rgba(0, 0, 0, 0.40)" },
    "lg": { "$value": "0 4px 8px rgba(0, 0, 0, 0.30), 0 20px 40px -12px rgba(0, 0, 0, 0.55)" },
    "xl": { "$value": "0 8px 16px rgba(0, 0, 0, 0.35), 0 32px 64px -16px rgba(0, 0, 0, 0.65)" }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "100ms", "$description": "Press feedback" },
    "fast": { "$value": "150ms", "$description": "Hover, color changes" },
    "base": { "$value": "220ms", "$description": "Small enter/exit, dropdowns" },
    "slow": { "$value": "320ms", "$description": "Sheets, modals, page-level reveals" },
    "slower": { "$value": "480ms", "$description": "Large hero entrances only" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "out": { "$value": [0.16, 1, 0.3, 1] },
    "in": { "$value": [0.4, 0, 1, 1] },
    "in-out": { "$value": [0.65, 0, 0.35, 1] }
  },
  "spring": {
    "$description": "For Motion / Framer Motion. bounce 0 by default; bounce only when a gesture carries momentum.",
    "snappy": { "$value": { "type": "spring", "stiffness": 520, "damping": 42, "mass": 1 } },
    "smooth": { "$value": { "type": "spring", "stiffness": 300, "damping": 34, "mass": 1 } },
    "gentle": { "$value": { "type": "spring", "stiffness": 180, "damping": 26, "mass": 1 } }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 100 },
    "dropdown": { "$value": 200 },
    "overlay": { "$value": 300 },
    "modal": { "$value": 400 },
    "toast": { "$value": 500 },
    "tooltip": { "$value": 600 }
  }
}
